{
  "name": "social-profile-url-parser",
  "version": "2.1.0",
  "packageManager": "pnpm@11.7.0",
  "description": "A Node.js library for extracting social media profile URLs from a block of text",
  "keywords": [
    "node",
    "social",
    "social media",
    "profile",
    "link",
    "url",
    "parser",
    "username"
  ],
  "author": "wvdp",
  "license": "MIT",
  "homepage": "https://github.com/wvanderp/social-profile-url-parser",
  "repository": {
    "type": "git",
    "url": "https://github.com/wvanderp/social-profile-url-parser.git"
  },
  "bugs": {
    "url": "https://github.com/wvanderp/social-profile-url-parser/issues"
  },
  "main": "./lib/index.js",
  "module": "./lib/index.mjs",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.mjs",
      "require": "./lib/index.js",
      "default": "./lib/index.mjs"
    },
    "./removeEmpty": {
      "types": "./lib/removeEmpty.d.ts",
      "import": "./lib/removeEmpty.mjs",
      "require": "./lib/removeEmpty.js",
      "default": "./lib/removeEmpty.mjs"
    }
  },
  "files": [
    "lib/**/*",
    "data/properties.json"
  ],
  "scripts": {
    "build": "tsdown",
    "lint": "tsc -p tsconfig.lint.json && eslint \"**/*.ts\"",
    "test": "vitest run --coverage",
    "collect": "ts-node ./scripts/collect.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^25.2.3",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitest/coverage-v8": "^3.2.4",
    "axios": "^1.13.5",
    "eslint": "^10.12.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^65.1.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^77.0.0",
    "globals": "^17.13.0",
    "html-escaper": "^3.0.3",
    "ts-node": "^10.9.2",
    "tsdown": "^0.21.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
