{
  "name": "social-profile-url-parser",
  "version": "2.1.0",
  "description": "A Node.js library for extracting social media profile URLs from a block of text",
  "keywords": [
    "node",
    "social",
    "social media",
    "profile",
    "link",
    "url",
    "parser",
    "username"
  ],
  "author": "wvdp",
  "license": "MIT",
  "homepage": "https://github.com/wvanderp/social-profile-url-parser",
  "repository": {
    "type": "git",
    "url": "https://github.com/wvanderp/social-profile-url-parser.git"
  },
  "bugs": {
    "url": "https://github.com/wvanderp/social-profile-url-parser/issues"
  },
  "main": "./lib/index.js",
  "module": "./lib/index.mjs",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.mjs",
      "require": "./lib/index.js",
      "default": "./lib/index.mjs"
    },
    "./removeEmpty": {
      "types": "./lib/removeEmpty.d.ts",
      "import": "./lib/removeEmpty.mjs",
      "require": "./lib/removeEmpty.js",
      "default": "./lib/removeEmpty.mjs"
    }
  },
  "files": [
    "lib/**/*",
    "data/properties.json"
  ],
  "scripts": {
    "build": "tsdown",
    "lint": "tsc -p tsconfig.lint.json && eslint . --ext .ts",
    "test": "vitest run --coverage",
    "collect": "ts-node ./scripts/collect.ts"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^3.2.4",
    "axios": "^1.13.5",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-compat": "^6.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^62.5.5",
    "eslint-plugin-ramda": "^2.5.1",
    "eslint-plugin-sonarjs": "^2.0.4",
    "eslint-plugin-unicorn": "^56.0.1",
    "html-escaper": "^3.0.3",
    "ts-node": "^10.9.2",
    "tsdown": "^0.21.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
