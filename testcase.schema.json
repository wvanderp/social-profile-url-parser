                "text": {
                    "type": "string",
                    "format": "uri",
                    "qt-uri-protocols": [
                        "https"
                    ]
                },
                "expected": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/Expected"
                    }
                }
            },
            "required": [
                "expected",
                "text"
            ],
            "title": "TestCaseElement"
        },
        "Expected": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "propertyId": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "url": {
                    "type": "string",
                    "format": "uri",
                    "qt-uri-protocols": [
                        "https"
                    ]
                },
                "identifier": {
                    "type": "string"
                },
                "deprecated": {
